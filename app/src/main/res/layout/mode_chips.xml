<?xml version="1.0" encoding="utf-8"?>
<!-- Professional | English | 中文 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mode_chips"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/chip_same"
        style="@style/ModeChip"
        android:text="@string/mode_same" />

    <TextView
        android:id="@+id/chip_english"
        style="@style/ModeChip"
        android:layout_marginStart="8dp"
        android:text="@string/mode_english" />

    <TextView
        android:id="@+id/chip_chinese"
        style="@style/ModeChip"
        android:layout_marginStart="8dp"
        android:text="@string/mode_chinese" />
</LinearLayout>
