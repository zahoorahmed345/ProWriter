<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#40FFFFFF">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <solid android:color="#993D4FE0" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:endColor="@color/brand_end" android:startColor="@color/brand" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
