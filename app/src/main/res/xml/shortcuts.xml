<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the Pro Writer icon → "Polish copied text" -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="polish_clipboard"
        android:shortcutLongLabel="@string/shortcut_long"
        android:shortcutShortLabel="@string/shortcut_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.prowriter.app.ClipboardActivity"
            android:targetPackage="com.prowriter.app" />
    </shortcut>
</shortcuts>
