<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the ProChat icon → "Polish copied text" / "Speak a message" -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="polish_clipboard"
        android:shortcutLongLabel="@string/shortcut_long"
        android:shortcutShortLabel="@string/shortcut_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.prowriter.app.ClipboardActivity"
            android:targetPackage="com.prowriter.app" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="speak_message"
        android:shortcutLongLabel="@string/shortcut_voice_long"
        android:shortcutShortLabel="@string/shortcut_voice_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.prowriter.app.ClipboardActivity"
            android:targetPackage="com.prowriter.app">
            <extra
                android:name="com.prowriter.app.VOICE"
                android:value="true" />
        </intent>
    </shortcut>
</shortcuts>
